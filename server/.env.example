# ─────────────────────────────────────────────────────────────
#  FARM-IQ  •  server/.env        (SECRET FILE — never commit)
#  Copy to ".env" and fill in.  .env is hidden by .gitignore
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# Session signing secret for login tokens (any long random string)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=30d

# Where the frontend runs (CORS allow-list, comma separated)
CLIENT_URL=http://localhost:5173

# ── Supabase (Project Settings → API) ────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Postgres connection for automatic table creation (Project Settings → Database)
# Either give the full URL, or give the DB password and we build it.
SUPABASE_DB_URL=
SUPABASE_DB_PASSWORD=

# ── Google Gemini (aistudio.google.com/app/apikey) ───────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Field cameras: how many photos to keep per camera (older ones are pruned)
CAMERA_MAX_PHOTOS=120
