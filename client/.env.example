# ─────────────────────────────────────────────────────────────
#  FARM-IQ  •  client/.env   (PUBLIC values only — no secrets!)
#  This file is safe to ship to the browser. It contains ONE thing:
#  the URL of our own backend. API keys never live here.
# ─────────────────────────────────────────────────────────────

# In development leave this empty — Vite proxies /api to localhost:5000.
# In production set it to the backend URL, e.g. https://farmiq-api.onrender.com
VITE_API_BASE_URL=
